[
  {
    "version": 1,
    "id": "subscription-fixed-price",
    "prompt": "Create one membership tier costing 5 BADGE per 30-day period, payable to the merchant. Lock mint pricing; start without holder-to-holder transfers.",
    "tool": "build_subscription",
    "input": {
      "uri": "https://example.com/golden-metadata.json",
      "interval": "30d",
      "price": 5,
      "denom": "BADGE",
      "recipient": "bb1zyg3zyg3zyg3zyg3zyg3zyg3zyg3zyg3zql3w7",
      "transferable": false,
      "updatableMint": false
    },
    "clarifications": [
      {
        "question": "Calendar month or 30 days?",
        "answer": "Exactly 30 days; no claim of automatic renewal."
      }
    ],
    "limitations": [
      "Unsigned builder proposal only; signer and manager must be bound before deployment.",
      "Artifact constraints only. No chain execution, wallet signing, live balance checks or external service verification.",
      "Initial holder-transfer restriction is checked; the builder retains manager ability to add non-mint transfer approvals. This is not immutable non-transferability."
    ],
    "assertions": [
      {
        "id": "create-message",
        "path": "/typeUrl",
        "operator": "equals",
        "expected": "/tokenization.MsgCreateCollection",
        "requirement": "Prepare a new collection"
      },
      {
        "id": "no-forceful-transfer",
        "path": "/value/invariants/noForcefulPostMintTransfers",
        "operator": "equals",
        "expected": true,
        "requirement": "Disallow forceful post-mint transfers"
      },
      {
        "id": "only-faucet",
        "path": "/value/collectionApprovals",
        "operator": "length",
        "expected": 1,
        "requirement": "No initial holder-transfer approval"
      },
      {
        "id": "mint-source",
        "path": "/value/collectionApprovals/0/fromListId",
        "operator": "equals",
        "expected": "Mint",
        "requirement": "Membership originates at Mint"
      },
      {
        "id": "payment",
        "path": "/value/collectionApprovals/0/approvalCriteria/coinTransfers",
        "operator": "equals",
        "expected": [
          {
            "to": "bb1zyg3zyg3zyg3zyg3zyg3zyg3zyg3zyg3zql3w7",
            "coins": [
              {
                "amount": "5000000000",
                "denom": "ubadge"
              }
            ],
            "overrideFromWithApproverAddress": false,
            "overrideToWithInitiator": false
          }
        ],
        "requirement": "Exactly 5 BADGE to the merchant; initiator pays"
      },
      {
        "id": "duration",
        "path": "/value/collectionApprovals/0/approvalCriteria/predeterminedBalances/incrementedBalances/durationFromTimestamp",
        "operator": "equals",
        "expected": "2592000000",
        "requirement": "Exactly 30 days in milliseconds"
      },
      {
        "id": "one-period",
        "path": "/value/collectionApprovals/0/approvalCriteria/predeterminedBalances/incrementedBalances/allowAmountScaling",
        "operator": "equals",
        "expected": false,
        "requirement": "One period per mint"
      },
      {
        "id": "mint-lock",
        "path": "/value/collectionPermissions/canUpdateCollectionApprovals",
        "operator": "equals",
        "expected": [
          {
            "fromListId": "Mint",
            "toListId": "All",
            "initiatedByListId": "All",
            "transferTimes": [
              {
                "start": "1",
                "end": "18446744073709551615"
              }
            ],
            "tokenIds": [
              {
                "start": "1",
                "end": "18446744073709551615"
              }
            ],
            "ownershipTimes": [
              {
                "start": "1",
                "end": "18446744073709551615"
              }
            ],
            "approvalId": "All",
            "permanentlyPermittedTimes": [],
            "permanentlyForbiddenTimes": [
              {
                "start": "1",
                "end": "18446744073709551615"
              }
            ]
          }
        ],
        "requirement": "Mint approval permissions remain locked for every token and time"
      },
      {
        "id": "recipient-consent",
        "path": "/value/collectionApprovals/0/approvalCriteria/overridesToIncomingApprovals",
        "operator": "equals",
        "expected": false,
        "requirement": "Do not bypass recipient incoming approvals"
      }
    ],
    "mutations": [
      {
        "id": "wrong-recipient",
        "path": "/value/collectionApprovals/0/approvalCriteria/coinTransfers/0/to",
        "value": "bb1xvenxvenxvenxvenxvenxvenxvenxvenlrd2nm",
        "mustFail": ["payment"]
      },
      {
        "id": "wrong-duration",
        "path": "/value/collectionApprovals/0/approvalCriteria/predeterminedBalances/incrementedBalances/durationFromTimestamp",
        "value": "2592000001",
        "mustFail": ["duration"]
      },
      {
        "id": "unlock-price",
        "path": "/value/collectionPermissions/canUpdateCollectionApprovals",
        "value": [],
        "mustFail": ["mint-lock"]
      },
      {
        "id": "bypass-consent",
        "path": "/value/collectionApprovals/0/approvalCriteria/overridesToIncomingApprovals",
        "value": true,
        "mustFail": ["recipient-consent"]
      }
    ]
  },
  {
    "version": 1,
    "id": "invoice-direct-payment",
    "prompt": "Request a one-time payment of 7 BADGE from the specified payer to the merchant. Expire after 30 days; no escrow or refund promise.",
    "tool": "build_payment_request",
    "input": {
      "uri": "https://example.com/golden-metadata.json",
      "amount": 7,
      "denom": "BADGE",
      "payer": "bb1xvenxvenxvenxvenxvenxvenxvenxvenlrd2nm",
      "recipient": "bb1zyg3zyg3zyg3zyg3zyg3zyg3zyg3zyg3zql3w7",
      "expiration": "30d"
    },
    "clarifications": [],
    "limitations": [
      "Unsigned builder proposal only; signer and manager must be bound before deployment.",
      "Artifact constraints only. No chain execution, wallet signing, live balance checks or external service verification."
    ],
    "assertions": [
      {
        "id": "create-message",
        "path": "/typeUrl",
        "operator": "equals",
        "expected": "/tokenization.MsgCreateCollection",
        "requirement": "Prepare a new collection"
      },
      {
        "id": "no-forceful-transfer",
        "path": "/value/invariants/noForcefulPostMintTransfers",
        "operator": "equals",
        "expected": true,
        "requirement": "Disallow forceful post-mint transfers"
      },
      {
        "id": "pay-and-deny",
        "path": "/value/collectionApprovals",
        "operator": "length",
        "expected": 2,
        "requirement": "Only pay and deny paths"
      },
      {
        "id": "payer",
        "path": "/value/collectionApprovals/0/initiatedByListId",
        "operator": "equals",
        "expected": "bb1xvenxvenxvenxvenxvenxvenxvenxvenlrd2nm",
        "requirement": "Only the specified payer initiates payment"
      },
      {
        "id": "payment",
        "path": "/value/collectionApprovals/0/approvalCriteria/coinTransfers",
        "operator": "equals",
        "expected": [
          {
            "to": "bb1zyg3zyg3zyg3zyg3zyg3zyg3zyg3zyg3zql3w7",
            "coins": [
              {
                "amount": "7000000000",
                "denom": "ubadge"
              }
            ],
            "overrideFromWithApproverAddress": false,
            "overrideToWithInitiator": false
          }
        ],
        "requirement": "Exactly 7 BADGE paid directly to merchant"
      },
      {
        "id": "one-payment",
        "path": "/value/collectionApprovals/0/approvalCriteria/maxNumTransfers/overallMaxNumTransfers",
        "operator": "equals",
        "expected": "1",
        "requirement": "One fulfillment allowed"
      },
      {
        "id": "deadline",
        "path": "/value/collectionApprovals/0/transferTimes",
        "operator": "equals",
        "expected": [
          {
            "start": "1",
            "end": "1896048000000"
          }
        ],
        "requirement": "Payment deadline is fixed time plus 30 days"
      },
      {
        "id": "no-prefunding",
        "path": "/value/mintEscrowCoinsToTransfer",
        "operator": "equals",
        "expected": [],
        "requirement": "No escrow funded on creation"
      },
      {
        "id": "terms-lock",
        "path": "/value/collectionPermissions/canUpdateCollectionApprovals",
        "operator": "equals",
        "expected": [
          {
            "fromListId": "All",
            "toListId": "All",
            "initiatedByListId": "All",
            "transferTimes": [
              {
                "start": "1",
                "end": "18446744073709551615"
              }
            ],
            "tokenIds": [
              {
                "start": "1",
                "end": "18446744073709551615"
              }
            ],
            "ownershipTimes": [
              {
                "start": "1",
                "end": "18446744073709551615"
              }
            ],
            "approvalId": "All",
            "permanentlyPermittedTimes": [],
            "permanentlyForbiddenTimes": [
              {
                "start": "1",
                "end": "18446744073709551615"
              }
            ]
          }
        ],
        "requirement": "Approval terms cannot be changed"
      }
    ],
    "mutations": [
      {
        "id": "public-payer",
        "path": "/value/collectionApprovals/0/initiatedByListId",
        "value": "All",
        "mustFail": ["payer"]
      },
      {
        "id": "repeat-payment",
        "path": "/value/collectionApprovals/0/approvalCriteria/maxNumTransfers/overallMaxNumTransfers",
        "value": "0",
        "mustFail": ["one-payment"]
      },
      {
        "id": "wrong-amount",
        "path": "/value/collectionApprovals/0/approvalCriteria/coinTransfers/0/coins/0/amount",
        "value": "7000000001",
        "mustFail": ["payment"]
      },
      {
        "id": "late-payment",
        "path": "/value/collectionApprovals/0/transferTimes/0/end",
        "value": "1896048000001",
        "mustFail": ["deadline"]
      }
    ]
  },
